# ------------------------------------------------------------------
# CareerCraft backend environment variables
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored. NEVER commit real secrets.
# ------------------------------------------------------------------

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/careercraft?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=careercraft_user
DB_PASSWORD=change_me

# --- JWT ---
# Must be a Base64 string of at least 32 bytes (256 bits).
# Generate one with:   openssl rand -base64 64
JWT_SECRET=PASTE_YOUR_GENERATED_BASE64_SECRET_HERE
# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Hibernate schema strategy ---
# "update" creates/extends tables automatically (local dev and first deploys).
# Once production is stable you can switch to "validate" (see Phase 9 guide).
JPA_DDL_AUTO=update

# --- Security / rate limits (Phase 9) ---
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=50
LOGIN_WINDOW_MINUTES=15
REGISTER_MAX_PER_HOUR=20

# --- Production tuning (optional) ---
# DB_POOL_SIZE=5
# DB_MAX_LIFETIME_MS=1500000
# FORWARD_HEADERS_STRATEGY=native
# On Render (behind Cloudflare) set this so rate limits see real visitor IPs:
# REMOTE_IP_HEADER=cf-connecting-ip

# --- Grok (xAI) - AI features (Phase 5+) ---
# Create a key at https://console.x.ai  (never put it in the frontend!)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
# Model id - see https://docs.x.ai/developers/models for current models
GROK_MODEL=grok-4.7
# low | medium | high | xhigh  (low = faster + cheaper, good for resume analysis)
GROK_REASONING_EFFORT=low
GROK_TIMEOUT_SECONDS=90
# Max analyses per user per day
AI_DAILY_LIMIT=20
# Max AI portfolio requests (generate + "write with AI") per user per day
AI_PORTFOLIO_DAILY_LIMIT=10
